# Copy to .env and edit. Never commit .env.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_cost
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# JSON list
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=30
MAX_PROMPT_CHARS=50000
# true = use built-in placeholder engines (no nlp_engine / cost_engine needed)
USE_STUB_ENGINES=true
SEED_ON_STARTUP=true
